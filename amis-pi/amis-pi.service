[Unit]
Description=AMIS Smartmeter Reader (MQTT + Fronius Modbus)
After=network-online.target
Wants=network-online.target

[Service]
User=amis
Group=dialout
WorkingDirectory=/opt/amis-pi
ExecStart=/opt/amis-pi/.venv/bin/python -m amis_pi -c /etc/amis-pi/config.toml
Restart=always
RestartSec=5
TimeoutStopSec=20
# erlaubt Port 502 ohne root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
